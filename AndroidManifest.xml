<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.android.systemui"
    android:sharedUserId="android.uid.systemui"
    coreApp="true">

    <original-package android:name="com.android.systemui" />

    <application
        android:appComponentFactory="com.miku.android.systemui.MikuSystemUIAppComponentFactory"
        tools:replace="android:appComponentFactory">
        <service
            android:name="com.miku.android.systemui.smartpixels.SmartPixelsService"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
